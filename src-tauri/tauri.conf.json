{
    "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
    "productName": "Storyboard Extractor",
    "version": "0.1.0",
    "identifier": "com.azhu-032.storyboardextractor",
    "build": {
        "frontendDist": "../dist",
        "devUrl": "http://localhost:4173",
        "beforeDevCommand": "npm run dev",
        "beforeBuildCommand": "npm run build"
    },
    "app": {
        "windows": [
            {
                "title": "Storyboard Extractor",
                "width": 800,
                "height": 600,
                "resizable": true,
                "fullscreen": false
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/icon.ico",
            "icons/32x32.png",
            "icons/64x64.png",
            "icons/128x128.png",
            "icons/256x256.png",
            "icons/512x512.png"
        ],
        "android": {
            "debugApplicationIdSuffix": ".debug"
        }
    }
}
